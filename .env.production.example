# === Email (Resend) ===
# Crear cuenta gratis en https://resend.com (3000 emails/mes free)
# Genera una API Key y pégala aquí. Si está vacío, los reportes no se envían (no falla).
RESEND_API_KEY=
RESEND_FROM=Brujula Markets <onboarding@resend.dev>
REPORT_RECIPIENT=velasquezorlandodavid@gmail.com

# === Cron secret · protege endpoints /api/cron/* ===
