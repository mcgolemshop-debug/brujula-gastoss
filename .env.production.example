# === Web Push (VAPID) ===
# Genera localmente con: node -e "console.log(require('web-push').generateVAPIDKeys())"
# Las mismas keys deben estar en .env.local Y en Vercel (de lo contrario las subs viejas dejan de funcionar)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BNxvCqtx1eI9ivUZeuaE_FVG8P4UTp99b-2EHHFEdWxUDcE9ZC7rzxJAFxph2LY_bU8XMLsxQOpYF_HYxvTrNpc
