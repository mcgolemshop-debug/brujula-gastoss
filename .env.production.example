# === Supabase (mismos valores que .env.local pero en Vercel) ===
NEXT_PUBLIC_SUPABASE_URL=https://jzkwqkazwhplzhnxtbex.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_OPEd__9yXKADqcbgf18CoQ_L9L6cbWQ

# Solo backend (NUNCA NEXT_PUBLIC_) — service_role bypass de RLS
