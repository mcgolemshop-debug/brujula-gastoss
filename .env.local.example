# ============================================================================
# Brújula Markets · Variables de entorno
# Copiar este archivo a `.env.local` (queda en .gitignore) y rellenar valores.
# ============================================================================

# === Supabase ===
# Para dev local con `supabase start`, usar los valores que imprime el CLI.
# Para producción, valores del dashboard de supabase.com.
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key-from-supabase-status

# Solo backend (Server Actions) — NO usar en cliente
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# === App ===
NEXT_PUBLIC_APP_URL=http://localhost:3000
